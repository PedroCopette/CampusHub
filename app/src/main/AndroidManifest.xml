<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LoginFirebase">

        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <activity
            android:name=".RegistrationActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <activity
            android:name=".EventsActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <activity
            android:name=".EventDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <activity
            android:name=".EventPhotosActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <!-- Tela de áudios dos eventos -->
        <activity
            android:name=".EventAudioActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <!-- Tela de vídeos dos eventos -->
        <activity
            android:name=".EventVideoActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <activity
            android:name=".MyEventsActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <activity
            android:name=".RecoveryActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <activity
            android:name=".FavoritesActivity"
            android:exported="false"
            android:theme="@style/Theme.LoginFirebase" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LoginFirebase"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
