rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /eventos/{uid}/{eventId}/{fileName} {
      function isOrganizer() {
        return request.auth != null
          && request.auth.uid == uid
          && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'organizador';
      }
      allow read: if request.auth != null;
      allow write: if isOrganizer()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
